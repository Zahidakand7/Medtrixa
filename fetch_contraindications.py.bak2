import argparse
import csv
import os
import re
import sqlite3
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor, as_completed

import requests

API_URL = "https://api.fda.gov/drug/label.json"
DEFAULT_DB = os.path.expanduser("~/Medtrixa/app/src/main/assets/database/drugs.db")
WORKERS = 10  # conservative; raise once you confirm your API key's rate limit


def get_api_key(cli_key):
    key = cli_key or os.environ.get("OPENFDA_API_KEY")
    if not key:
        sys.exit("No API key. Run: export OPENFDA_API_KEY=... or pass --api-key")
    return key


def load_names(db_path, only=None):
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    cur.execute(
        "SELECT DISTINCT genericName FROM drugs WHERE genericName IS NOT NULL ORDER BY genericName"
    )
    names = [row[0] for row in cur.fetchall()]
    conn.close()
    if only:
        only_lower = {o.strip().lower() for o in only}
        names = [n for n in names if n.split(",")[0].split("(")[0].strip().lower() in only_lower]
    return names


def load_done(out_path):
    """Rows already fetched successfully. status == 'error' is NOT counted done,
    so a rerun retries it instead of leaving it blank forever."""
    done = set()
    if os.path.exists(out_path):
        with open(out_path, newline="", encoding="utf-8") as f:
            reader = csv.reader(f)
            next(reader, None)
            for row in reader:
                if len(row) >= 3 and row[2] != "error":
                    done.add(row[0])
                elif len(row) == 2:  # tolerate old 2-column files
                    done.add(row[0])
    return done


SALT_SUFFIXES = {
    "hydrochloride", "hcl", "hbr", "sodium", "potassium", "calcium",
    "sulfate", "tartrate", "bitartrate", "maleate", "besylate", "besilate",
    "succinate", "fumarate", "mesylate", "phosphate", "citrate", "acetate",
    "hemihydrate", "monohydrate", "dihydrate", "napsylate", "pamoate",
    "stearate", "valerate", "propionate", "benzoate", "gluconate",
    "lactate", "malate", "oxalate", "chloride", "extended-release",
    "er", "xr", "cr", "dr",
}


def norm(s):
    return s.strip().lower() if s else ""


def base_ingredient(raw):
    """Normalize a label/query ingredient name by stripping trailing salt or
    formulation qualifiers, e.g. 'Metformin Hydrochloride' -> 'metformin'."""
    words = norm(raw).replace(",", " ").split()
    while words and words[-1] in SALT_SUFFIXES:
        words.pop()
    return " ".join(words)


def ingredient_tokens(name):
    """Split a combo name like 'A/B' into its component raw ingredient strings."""
    parts = [p.split("(")[0].strip() for p in name.split("/")]
    return {base_ingredient(p) for p in parts if p}


def label_ingredient_set(label, field="ingredient"):
    openfda = label.get("openfda", {})
    if field == "brand":
        vals = openfda.get("brand_name", [])
    else:
        vals = openfda.get("generic_name", []) + openfda.get("substance_name", [])
    return {base_ingredient(v) for v in vals if v}


def is_exact_match(query_name, label, field="ingredient"):
    query_tokens = ingredient_tokens(query_name)
    label_names = label_ingredient_set(label, field=field)
    if not label_names or not query_tokens:
        return False
    # exact set equality after salt-stripping: rules out combo products
    # (extra ingredients) while tolerating salt-form naming differences
    if field == "brand":
        return query_tokens <= label_names
    return query_tokens == label_names


def extract_text(label):
    c = label.get("contraindications", [])
    return " ".join(c).replace("\n", " ").strip() if c else ""


def is_none_stated(text):
    return text.strip().rstrip(".").lower() == "none"


def search(field, value, api_key):
    params = {"search": f'{field}:"{value}"', "limit": 50, "api_key": api_key}
    resp = requests.get(API_URL, params=params, timeout=20)
    return resp


def best_from_results(query_name, results, field="ingredient"):
    """Return (text, status) from a list of label results, or None if no exact match found."""
    best_text, best_is_real, saw_match = None, False, False
    for label in results:
        if not is_exact_match(query_name, label, field=field):
            continue
        saw_match = True
        text = extract_text(label)
        if not text:
            continue
        if is_none_stated(text):
            if best_text is None:
                best_text, best_is_real = text, False
        else:
            return text, "has_text"  # real text wins immediately
    if best_text is not None:
        return best_text, "none_stated"
    if saw_match:
        return "", "no_data"  # matched drug, but no contraindications field at all
    return None


def fetch_one(name, api_key):
    query_name = name.split(",")[0].split("(")[0].strip()

    for attempt in range(4):
        try:
            resp = search("openfda.generic_name", query_name, api_key)
            if resp.status_code == 429:
                time.sleep(2 * (attempt + 1))
                continue
            if resp.status_code not in (200, 404):
                time.sleep(1 * (attempt + 1))
                continue

            results = resp.json().get("results", []) if resp.status_code == 200 else []
            outcome = best_from_results(query_name, results) if results else None
            if outcome:
                return name, outcome[0], outcome[1]

            # fallback: substance name, then brand name
            for field, match_field in (
                ("openfda.substance_name", "ingredient"),
                ("openfda.brand_name", "brand"),
            ):
                resp2 = search(field, query_name, api_key)
                if resp2.status_code == 200:
                    results2 = resp2.json().get("results", [])
                    outcome2 = best_from_results(query_name, results2, field=match_field) if results2 else None
                    if outcome2:
                        return name, outcome2[0], outcome2[1]

            return name, "", "no_data"

        except requests.RequestException:
            time.sleep(1 * (attempt + 1))
            continue

    return name, "", "error"  # exhausted retries on network errors -> retry on rerun


def cmd_fetch(args):
    api_key = get_api_key(args.api_key)
    names = load_names(args.db, only=args.only)
    done = load_done(args.output_csv)
    remaining = [n for n in names if n not in done]

    print(f"Total: {len(names)} | Already done: {len(done)} | Remaining: {len(remaining)}")
    if not remaining:
        print("Nothing to do (all names already fetched successfully). Use --only to re-target specific drugs.")
        return

    write_header = not os.path.exists(args.output_csv)
    out_f = open(args.output_csv, "a", newline="", encoding="utf-8")
    writer = csv.writer(out_f)
    if write_header:
        writer.writerow(["genericName", "contraindications", "status"])
    lock = threading.Lock()

    completed = 0
    with ThreadPoolExecutor(max_workers=WORKERS) as executor:
        futures = {executor.submit(fetch_one, name, api_key): name for name in remaining}
        for future in as_completed(futures):
            name, text, status = future.result()
            with lock:
                writer.writerow([name, text, status])
                out_f.flush()
                completed += 1
                if completed % 50 == 0:
                    print(f"{completed}/{len(remaining)} done...")

    out_f.close()
    print("Done.")


def clean_text(text):
    if not text:
        return text
    for prefix in ("4 CONTRAINDICATIONS", "CONTRAINDICATIONS"):
        if text.upper().startswith(prefix):
            text = text[len(prefix):].strip(" .:-")
    text = re.sub(r"\[see Warnings and Precautions[^\]]*\]", "", text, flags=re.IGNORECASE)
    text = re.sub(r"\(\s*4\s*\)", "", text)
    text = re.sub(r"\s{2,}", " ", text).strip()
    if text.strip(" .").lower() == "none":
        text = "None."
    return text


def cmd_clean(args):
    with open(args.input_csv, newline="", encoding="utf-8") as f:
        reader = csv.reader(f)
        header = next(reader)
        rows = list(reader)

    with open(args.output_csv, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["genericName", "contraindications", "status"])
        for row in rows:
            name = row[0]
            raw_text = row[1] if len(row) > 1 else ""
            text = clean_text(raw_text)
            if len(row) > 2 and row[2]:
                status = row[2]
            else:
                status = "has_text" if text and text != "None." else ("none_stated" if text == "None." else "no_data")
            writer.writerow([name, text, status])
    print(f"Cleaned {len(rows)} rows -> {args.output_csv}")


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)

    p_fetch = sub.add_parser("fetch")
    p_fetch.add_argument("output_csv")
    p_fetch.add_argument("--db", default=DEFAULT_DB)
    p_fetch.add_argument("--only", action="append", default=None)
    p_fetch.add_argument("--api-key", default=None)
    p_fetch.set_defaults(func=cmd_fetch)

    p_clean = sub.add_parser("clean")
    p_clean.add_argument("input_csv")
    p_clean.add_argument("output_csv")
    p_clean.set_defaults(func=cmd_clean)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
