package com.medtrixa.app.ui.screens.more.topics

import com.medtrixa.app.ui.screens.more.*

internal val cypA: List<TopicSection> = listOf(
    TopicSection("How to Use This Guide", listOf(
        TopicBlock.Text("Cytochrome P450 (CYP) enzymes metabolize most drugs. A substrate is cleared by the enzyme, an inhibitor slows the enzyme, and an inducer increases the amount of enzyme. The lists follow FDA classifications and give examples, not complete lists."),
        TopicBlock.Bullets(listOf(
            "Sensitive substrate: Exposure rises 5-fold or more when a strong inhibitor is given.",
            "Strong inhibitor: Raises substrate exposure 5-fold or more.",
            "Moderate inhibitor: Raises exposure 2-fold to less than 5-fold.",
            "Weak inhibitor: Raises exposure 1.25-fold to less than 2-fold.",
            "Strong inducer: Lowers substrate exposure by 80% or more.",
            "Moderate inducer: Lowers exposure by 50% to less than 80%.",
            "Prodrugs: Inhibition reduces the formation of the active metabolite, so the effect falls instead of rising."
        ))
    ), TopicAccent.BLUE),
    TopicSection("CYP3A4 and CYP3A5", listOf(
        TopicBlock.Text("The most abundant drug-metabolizing enzymes in the liver and gut wall. They handle about half of all drugs, and many CYP3A4 inhibitors also inhibit P-glycoprotein."),
        TopicBlock.Abbreviations(listOf(
            AbbrevRow("Sensitive substrates", "", "Midazolam, triazolam, simvastatin, lovastatin, tacrolimus, sirolimus, everolimus, buspirone, vardenafil, saquinavir"),
            AbbrevRow("Other substrates", "", "Atorvastatin, amlodipine, nifedipine, diltiazem, verapamil, cyclosporine, fentanyl, oxycodone, methadone, apixaban, rivaroxaban, quetiapine, zolpidem, sildenafil, tadalafil, ethinylestradiol, carbamazepine"),
            AbbrevRow("Strong inhibitors", "", "Clarithromycin, itraconazole, ketoconazole, posaconazole, voriconazole, ritonavir, cobicistat, nelfinavir, saquinavir, indinavir, nefazodone, telithromycin"),
            AbbrevRow("Moderate inhibitors", "", "Diltiazem, verapamil, erythromycin, fluconazole, aprepitant, imatinib, ciprofloxacin, crizotinib, dronedarone, grapefruit juice"),
            AbbrevRow("Strong inducers", "", "Rifampin, carbamazepine, phenytoin, St John's wort, enzalutamide, mitotane"),
            AbbrevRow("Moderate inducers", "", "Efavirenz, etravirine, modafinil, bosentan, nafcillin, phenobarbital")
        )),
        TopicBlock.Bullets(listOf(
            "Simvastatin and lovastatin: Contraindicated with strong inhibitors such as clarithromycin, itraconazole and ritonavir, because of the risk of rhabdomyolysis.",
            "Midazolam and triazolam: Strong inhibitors cause a marked rise in exposure and prolonged sedation.",
            "Tacrolimus, cyclosporine and sirolimus: Narrow therapeutic index, so monitor levels whenever an inhibitor or inducer is started or stopped.",
            "Oral contraceptives: Efficacy can fall with strong inducers such as rifampin, carbamazepine and St John's wort.",
            "Apixaban and rivaroxaban: Exposure rises with combined strong CYP3A4 and P-glycoprotein inhibitors and falls with strong inducers.",
            "Grapefruit juice: Inhibits intestinal CYP3A4 and can raise levels of sensitive substrates for at least 24 hours."
        ))
    ), TopicAccent.RED),
    TopicSection("CYP2D6", listOf(
        TopicBlock.Text("A highly polymorphic enzyme with no clinically established inducers. Genetic variation and inhibitors matter most, especially for prodrugs."),
        TopicBlock.Abbreviations(listOf(
            AbbrevRow("Sensitive substrates", "", "Atomoxetine, desipramine, dextromethorphan, nebivolol, nortriptyline, perphenazine, tolterodine, venlafaxine"),
            AbbrevRow("Other substrates", "", "Codeine, tramadol, tamoxifen, metoprolol, carvedilol, amitriptyline, haloperidol, risperidone, aripiprazole, propafenone, flecainide"),
            AbbrevRow("Strong inhibitors", "", "Bupropion, fluoxetine, paroxetine, quinidine, terbinafine"),
            AbbrevRow("Moderate inhibitors", "", "Duloxetine, cinacalcet"),
            AbbrevRow("Inducers", "", "No clinically important inducers are established")
        )),
        TopicBlock.Bullets(listOf(
            "Codeine and tramadol: Prodrugs activated by CYP2D6, so inhibitors and poor metabolizers get less analgesia, and ultrarapid metabolizers risk morphine toxicity.",
            "Tamoxifen: Activation to endoxifen falls with strong inhibitors such as paroxetine and fluoxetine.",
            "Metoprolol and carvedilol: Exposure rises with inhibitors, raising the risk of bradycardia and hypotension.",
            "Antidepressants and antipsychotics: Levels rise with inhibitors, so adjust doses and watch for adverse effects.",
            "Poor metabolizers: About 5 - 10% of people of European ancestry."
        ))
    ), TopicAccent.VIOLET)
)
