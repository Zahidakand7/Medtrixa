package com.medtrixa.app.ui.screens.more.topics

import com.medtrixa.app.ui.screens.more.*

val DosageAbbreviationsTopic = MoreTopic(
    id = "dosage_abbreviations",
    title = "Prescription Terminology",
    subtitle = "BID, TID, PRN and Safe Prescription Shorthand",
    badge = "Rx",
    accent = TopicAccent.TEAL,
    category = "Dosage",
    keywords = listOf("bid", "tid", "qid", "qd", "prn", "stat", "sig", "abbreviations", "dosage abbreviations", "frequency", "route", "latin", "do not use", "ismp", "joint commission", "dosage guide"),
    sections = listOf(
        TopicSection("Prescription Instructions", listOf(
            TopicBlock.Text("Prescription directions define five key elements. Use the complete prescription and the medication-specific instructions."),
            TopicBlock.Bullets(listOf(
                "Frequency: how often the medication is used",
                "Timing: when it is used, including relation to meals or other events",
                "Route: how it enters or is applied to the body",
                "Regimen: the dose, strength, duration and any adjustments",
                "Safety: checks needed to prevent errors"
            ))
        ), TopicAccent.BLUE),

        TopicSection("Frequency and Timing", listOf(
            TopicBlock.Text("BID, TID and QID give the number of doses per day. q8h and q12h specify exact intervals. Follow the prescription as written. Unsafe frequency abbreviations such as QD and QOD are listed under Abbreviations to Avoid."),
            TopicBlock.Abbreviations(listOf(
                AbbrevRow("BID", "Bis in die", "Twice daily", note = "Spaced across the waking day. For strict 12-hour spacing, q12h is written."),
                AbbrevRow("TID", "Ter in die", "Three times daily", note = "Usually morning, afternoon and evening. For strict 8-hour spacing, q8h is written."),
                AbbrevRow("QID", "Quater in die", "Four times daily", note = "For strict 6-hour spacing, q6h is written."),
                AbbrevRow("q4h", "Quaque quarta hora", "Every 4 hours", note = "Evenly spaced intervals. This matters for drugs whose effect depends on steady levels, such as many antibiotics and anticonvulsants."),
                AbbrevRow("q6h", "Quaque sexta hora", "Every 6 hours"),
                AbbrevRow("q8h", "Quaque octava hora", "Every 8 hours"),
                AbbrevRow("q12h", "Quaque duodecima hora", "Every 12 hours"),
                AbbrevRow("qAM", "Quaque + AM (ante meridiem)", "Every morning"),
                AbbrevRow("qPM", "Quaque + PM (post meridiem)", "Every evening"),
                AbbrevRow("QHS", "Quaque hora somni", "At bedtime", note = "ISMP advises QHS rather than HS or nightly."),
                AbbrevRow("PRN", "Pro re nata", "As needed", note = "Confirm the reason, the minimum interval and the maximum daily amount."),
                AbbrevRow("STAT", "Statim", "Immediately, usually once"),
                AbbrevRow("ATC", "Around the clock", "Scheduled at fixed intervals, not as needed"),
                AbbrevRow("Weekly", "Every 7 days", "Once per week", note = "Write the day of the week. Daily versus weekly mix-ups with weekly drugs such as Methotrexate are a recognized cause of serious harm.")
            ))
        ), TopicAccent.VIOLET),

        TopicSection("Meal Instructions", listOf(
            TopicBlock.Text("Meal requirements vary by medication. Follow the product-specific instructions."),
            TopicBlock.Bullets(listOf(
                "AC: Latin ante cibum, meaning before meals.",
                "PC: Latin post cibum, meaning after meals.",
                "With Food: Take during or right after eating. Often used to reduce stomach upset.",
                "Empty Stomach: Take without food. Follow the medication-specific fasting instructions, commonly at least 1 hour before or 2 hours after a meal.",
                "With or Without Food: Food is not required. This applies only if the product instructions permit it.",
                "NPO: Latin nil per os, meaning nothing by mouth."
            ))
        ), TopicAccent.AMBER),

        TopicSection("Routes of Administration", listOf(
            TopicBlock.Text("Verify the route, especially when multiple formulations are available. The subcutaneous and eye-route abbreviations are listed under Abbreviations to Avoid."),
            TopicBlock.Abbreviations(listOf(
                AbbrevRow("PO", "Per os", "By mouth"),
                AbbrevRow("IV", "Intravenous", "Into a vein"),
                AbbrevRow("IM", "Intramuscular", "Into a muscle"),
                AbbrevRow("ID", "Intradermal", "Into the skin"),
                AbbrevRow("SL", "Sublingual", "Under the tongue"),
                AbbrevRow("PR", "Per rectum", "By the rectal route"),
                AbbrevRow("IN", "Intranasal", "Through the nose"),
                AbbrevRow("INH", "Inhalation", "Breathed into the respiratory tract"),
                AbbrevRow("TOP", "Topical", "Applied to a body surface"),
                AbbrevRow("NG", "Nasogastric", "Via a tube from the nose to the stomach")
            ))
        ), TopicAccent.TEAL),

        TopicSection("Units of Measure", listOf(
            TopicBlock.Abbreviations(listOf(
                AbbrevRow("mg", "Milligram", "One thousandth of a gram"),
                AbbrevRow("mcg", "Microgram", "One thousandth of a milligram"),
                AbbrevRow("g", "Gram", "1 g equals 1000 mg"),
                AbbrevRow("mL", "Milliliter", "Unit of liquid volume")
            ))
        ), TopicAccent.ROSE),

        TopicSection("Abbreviations to Avoid", listOf(
            TopicBlock.Callout(
                "Some Abbreviations Are Unsafe",
                "Two safety organizations publish lists of abbreviations that are known to cause medication errors. The Joint Commission, a United States organization that accredits hospitals and other healthcare organizations, requires its accredited organizations to avoid the abbreviations on its Do Not Use list. The Institute for Safe Medication Practices (ISMP), a nonprofit medication-safety organization, publishes a longer list of error-prone abbreviations, symbols and dose designations. Each item below shows what it stands for, which list flags it, why it is risky and the safer form to write instead.",
                CalloutKind.WARNING
            ),
            TopicBlock.Bullets(listOf(
                "QD: Latin quaque die, meaning once daily. It is on the Joint Commission Do Not Use list, because it is easily misread as QID or QOD. Write instead: once daily.",
                "QOD: Latin quaque altera die, meaning every other day. It is on the Joint Commission Do Not Use list, because it is easily misread as QD or QID. Write instead: every other day.",
                "U, IU: U stands for unit and IU for international unit, used for biologics such as Insulin. Both are on the Joint Commission Do Not Use list, because U can be misread as 0, 4 or cc, and IU as IV or 10. Write instead: units.",
                ".5 mg: A dose written without a leading zero, meaning half a milligram. This format is on the Joint Commission Do Not Use list, because a missed decimal point can cause a tenfold overdose. Write instead: 0.5 mg.",
                "5.0 mg: A dose written with a trailing zero, meaning five milligrams. This format is on the Joint Commission Do Not Use list, because it can be misread as 50 mg. Write instead: 5 mg.",
                "MS, MSO4, MgSO4: Shorthand for morphine sulfate or magnesium sulfate. They are on the Joint Commission Do Not Use list, because they are easily confused with each other. Write instead: Morphine Sulfate/Magnesium Sulfate.",
                "SC, SQ: Shorthand for subcutaneous, meaning under the skin. They are on the ISMP list of error-prone abbreviations, because they can be misread as SL or as 5 every. Write instead: subcut or subcutaneous.",
                "OD, OS, OU: Latin oculus dexter, oculus sinister and oculus uterque, meaning right eye, left eye and both eyes. They are on the ISMP list of error-prone abbreviations, because OD is also read as once daily or overdose. Write instead: right eye, left eye or both eyes.",
                "µg: The symbol for microgram. It is on the ISMP list of error-prone abbreviations, because it can be misread as mg. Write instead: mcg.",
                "cc: Abbreviation for cubic centimeter, equal to 1 mL. It is on the ISMP list of error-prone abbreviations, because it can be misread as U (units). Write instead: mL.",
                "HS: Latin hora somni, meaning at bedtime. It is on the ISMP list of error-prone abbreviations. Write instead: QHS."
            ))
        ), TopicAccent.RED),

        TopicSection("Dosage Fundamentals", listOf(
            TopicBlock.Bullets(listOf(
                "Dose: Amount administered at one time",
                "Dosage Regimen: Complete plan for dose, frequency, route and duration",
                "Strength: Amount of active ingredient per unit",
                "Daily Dose: Total amount administered in 24 hours",
                "Loading Dose: Initial dose used to reach a therapeutic concentration quickly",
                "Maintenance Dose: Repeated dose used to maintain the desired effect",
                "Titration: Gradual dose adjustment based on response or tolerability",
                "Tapering: Gradual dose reduction",
                "Maximum Daily Dose: Maximum permitted total amount in 24 hours",
                "Duration: Length of treatment",
                "mg/kg: Weight-based dose. Common in pediatrics. Confirm the current weight and the maximum dose."
            ))
        ), TopicAccent.GREEN),

        TopicSection("Reading a Prescription", listOf(
            TopicBlock.Example("Interpretation Example", "500 mg PO BID for 5 days", "500 mg by mouth twice daily for 5 days, 1,000 mg per day in total. This is an interpretation example, not a treatment recommendation."),
            TopicBlock.Example("Antibiotic Course", "Amoxicillin 500 mg PO TID x 7 days", "Take 500 mg by mouth three times daily for 7 days."),
            TopicBlock.Example("Pain Relief", "Ibuprofen 400 mg PO q6h PRN pain", "Take 400 mg by mouth every 6 hours as needed for pain."),
            TopicBlock.Example("Chronic Therapy", "Metformin 500 mg PO BID with meals", "Take 500 mg by mouth twice daily with meals."),
            TopicBlock.Example("Emergency Order", "Furosemide 40 mg IV STAT", "Give 40 mg intravenously immediately, one time.")
        ), TopicAccent.BLUE),

        TopicSection("Common Instructions", listOf(
            TopicBlock.Bullets(listOf(
                "Take as Directed: Follow the prescriber's instructions.",
                "Do Not Crush or Chew: Swallow intact when required, especially modified-release or enteric-coated products.",
                "Shake Well Before Use: Redistributes particles before measuring a liquid.",
                "Complete the Prescribed Course: Follow the specified duration.",
                "Missed Dose: Follow medication-specific instructions. Do not automatically double the next dose.",
                "PRN Use: Confirm the indication, the minimum interval and the maximum daily amount."
            ))
        ), TopicAccent.AMBER),

        TopicSection("Safety Checks", listOf(
            TopicBlock.Bullets(listOf(
                "Prefer clear wording: once daily instead of QD, every other day instead of QOD, and units instead of U.",
                "Use leading zeros: write 0.5 mg, not .5 mg.",
                "Avoid trailing zeros: write 5 mg, not 5.0 mg.",
                "Frequency is not the same as interval: three times daily is not always equivalent to every 8 hours.",
                "Verify patient-specific factors: age, weight, renal and hepatic function, indication, formulation and other medicines.",
                "Clarify ambiguous prescriptions with the prescriber or pharmacist before administration."
            )),
            TopicBlock.Callout(
                "Disclaimer",
                "This guide is an educational reference for prescription terminology. It does not replace approved product information, institutional policy or clinical judgment. Use clear, complete instructions whenever possible.",
                CalloutKind.INFO
            )
        ), TopicAccent.ROSE)
    ),
    references = listOf(
        "Institute for Safe Medication Practices (ISMP). List of Error-Prone Abbreviations, Symbols, and Dose Designations. 2024.",
        "The Joint Commission. Official Do Not Use List of Abbreviations. Information Management standard IM.02.02.01."
    )
)
