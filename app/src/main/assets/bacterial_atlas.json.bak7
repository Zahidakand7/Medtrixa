      "id": "v_cholerae",
      "name": "Vibrio cholerae",
      "group": "Gram-negative",
      "morphology": "Curved Gram-negative bacilli (comma-shaped) with a single polar flagellum",
      "tagline": "Toxigenic waterborne pathogen causing profuse rice-water diarrhoea and rapid dehydration; epidemics follow poor sanitation and unsafe water.",
      "diseases": [
        "Cholera (profuse secretory diarrhoea)",
        "Severe dehydration with hypovolaemic shock",
        "Electrolyte disturbance (hypokalaemia, metabolic acidosis)",
